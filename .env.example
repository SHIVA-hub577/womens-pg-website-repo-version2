# Server Port
PORT=3000

# Database
MONGODB_URI=mongodb://localhost:27017/womens-pg

# Session Secret
SESSION_SECRET=your_session_secret_key

# Google OAuth & Nodemailer Credentials
GOOGLEUSER=your_email@gmail.com
# Option A: Standard Gmail App Password (Recommended for Nodemailer)
GMAIL_APP_PASSWORD=xxxx-xxxx-xxxx-xxxx

# Option B: Google OAuth2 Credentials
GOOGLECLIENTID=your_google_client_id
GOOGLECLIENTSECRET=your_google_client_secret
GOOGLEREFRESHTOKEN=your_google_refresh_token

