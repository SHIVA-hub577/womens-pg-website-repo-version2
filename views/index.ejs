      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-question">
          <span>Are 3 daily meals included in the monthly rent?</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          Yes! Nutritious home-style cooked breakfast, lunch, and dinner are included in the monthly rent, prepared in a hygienic kitchen using fresh ingredients.
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-question">
          <span>How is security managed at Pujyasritha's Living?</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          We prioritize resident safety above all else. We feature 24/7 security wardens, biometric access control at entry gates, CCTV surveillance in common areas, and strict visitor verification.
        </div>
      </div>

      <div class="faq-item" onclick="toggleFaq(this)">
        <div class="faq-question">
          <span>How can residents log complaints or maintenance requests?</span>
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="6 9 12 15 18 9"/></svg>
        </div>
        <div class="faq-answer">
          Residents can log into the Resident Portal anytime to lodge maintenance issues (plumbing, electrical, Wi-Fi, cleaning) and track resolution status in real time.
        </div>
      </div>
    </div>
  </section>

  <!-- Room Details Popup Modal -->
  <div class="modal-overlay" id="roomModalOverlay" onclick="closeRoomModal(event)">
    <div class="modal-card-box" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeRoomModal()">&times;</button>
      <img id="modalImg" class="modal-hero-img" src="" alt="Room Photo">
      <div class="modal-content-inner">
        <div class="modal-title-row">
          <h3 id="modalTitle">Room Title</h3>
          <div class="modal-price" id="modalPrice">₹0 / mo</div>
        </div>
        <p class="modal-desc-text" id="modalDesc">Room description goes here.</p>
        
        <div class="modal-details-grid">
          <div class="modal-detail-item">
            <strong>Sharing Type</strong>
            <span id="modalSharing">1-Sharing</span>
          </div>
          <div class="modal-detail-item">
            <strong>Capacity</strong>
            <span id="modalCapacity">1 Person</span>
          </div>
          <div class="modal-detail-item">
            <strong>Security Deposit</strong>
            <span id="modalDeposit">₹10,000</span>
          </div>
          <div class="modal-detail-item">
            <strong>Maintenance</strong>
            <span>Included in Rent</span>
          </div>
        </div>

        <div style="margin-bottom: 1.25rem;">
          <strong style="display: block; font-size: 0.9rem; margin-bottom: 0.5rem; color: var(--text-dark);">Included Features & Amenities:</strong>
          <div class="room-amenities" id="modalAmenitiesList">
            <!-- Amenities inserted dynamically -->
          </div>
        </div>

        <div style="display: flex; gap: 0.75rem;">
          <a href="/login" class="btn btn-primary" style="flex: 1;">Resident Login</a>
          <a href="/register" class="btn btn-outline" style="flex: 1;">Register to Book</a>
        </div>
      </div>
    </div>
  </div>

  <script>
    // Room Modal Handler
    function openRoomModal(sharingType, title, imgUrl, price, deposit, capacity, description, amenities) {
      document.getElementById('modalTitle').textContent = title;
      document.getElementById('modalImg').src = imgUrl;
      document.getElementById('modalPrice').textContent = price;
      document.getElementById('modalSharing').textContent = sharingType;
      document.getElementById('modalCapacity').textContent = capacity;
      document.getElementById('modalDeposit').textContent = deposit;
      document.getElementById('modalDesc').textContent = description;

      const amenitiesContainer = document.getElementById('modalAmenitiesList');
      amenitiesContainer.innerHTML = '';
      amenities.forEach(item => {
        const span = document.createElement('span');
        span.className = 'amenity-chip';
        span.textContent = item;
        amenitiesContainer.appendChild(span);
      });

      document.getElementById('roomModalOverlay').classList.add('active');
    }

    function closeRoomModal(e) {
      document.getElementById('roomModalOverlay').classList.remove('active');
    }

    // Manual Arrow Button Navigation for Carousel
    function scrollCarousel(distance) {
      const outer = document.getElementById('carouselOuter');
      const track = document.getElementById('carouselTrack');
      
      track.style.animationPlayState = 'paused';
      outer.scrollBy({ left: distance, behavior: 'smooth' });

      setTimeout(() => {
        track.style.animationPlayState = 'running';
      }, 3500);
    }

    // FAQ Accordion Handler
    function toggleFaq(element) {
      const isAlreadyActive = element.classList.contains('active');
      document.querySelectorAll('.faq-item').forEach(item => item.classList.remove('active'));
      if (!isAlreadyActive) {
        element.classList.add('active');
      }
    }
  </script>

  <%- include('partials/footer') %>
</body>
</html>
