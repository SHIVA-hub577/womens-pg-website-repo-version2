<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Complaints Management — Pujyasritha's Living</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar') %>

    <main class="main-content">
      <div style="margin-bottom: 1.5rem;">
        <h1>Resident Complaints Directory</h1>
        <p style="color: var(--text-muted);">Manage resident reported issues, inspect photo evidence, and post resolution notes.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-info"><%= success %></div>
      <% } %>

      <div class="card">
        <% if (complaints && complaints.length > 0) { %>
          <div style="display: flex; flex-direction: column; gap: 1.5rem;">
            <% complaints.forEach(c => { %>
              <div style="background: #FFF; border: 1px solid var(--border-color); border-left: 5px solid <%= c.status === 'Raised' ? '#F59E0B' : '#22C55E' %>; border-radius: var(--radius); padding: 1.5rem; box-shadow: var(--shadow-sm);">
                
                <!-- Complaint Header & Status -->
                <div style="display: flex; justify-content: space-between; align-items: flex-start; flex-wrap: wrap; gap: 0.5rem; margin-bottom: 1rem; border-bottom: 1px solid var(--border-color); padding-bottom: 0.75rem;">
                  <div>
                    <h3 style="margin-bottom: 0.2rem; color: var(--primary);">
                      Room <%= c.roomNumber %> &bull; <span style="color: var(--text-dark); font-weight: 600;"><%= c.tenantName %></span>
                    </h3>
                    <p style="font-size: 0.85rem; color: var(--text-muted);">
                      Phone: <strong><%= c.tenantPhone %></strong> &bull; Email: <strong><%= c.tenantEmail %></strong>
                    </p>
                  </div>
                  <div>
                    <% if (c.status === 'Raised') { %>
                      <span class="badge badge-yellow" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">Raised</span>
                    <% } else { %>
                      <span class="badge badge-green" style="font-size: 0.85rem; padding: 0.35rem 0.75rem;">Resolved</span>
                    <% } %>
                    <p style="font-size: 0.8rem; color: var(--text-muted); margin-top: 0.3rem; text-align: right;">
                      <%= new Date(c.raisedAt).toLocaleString('en-IN') %>
                    </p>
                  </div>
                </div>

                <!-- Complaint Problem Description & Photo -->
                <div style="margin-bottom: 1.25rem;">
                  <p style="font-size: 0.85rem; color: var(--text-muted); font-weight: 600; uppercase; letter-spacing: 0.05em;">Resident Description:</p>
                  <p style="font-size: 0.95rem; color: var(--text-dark); margin-top: 0.3rem; line-height: 1.5; white-space: pre-wrap;"><%= c.description %></p>
                  
                  <% if (c.photo) { %>
                    <div style="margin-top: 0.75rem;">
                      <p style="font-size: 0.8rem; color: var(--text-muted); margin-bottom: 0.3rem;">Resident Uploaded Photo:</p>
                      <a href="<%= c.photo %>" target="_blank">
                        <img src="<%= c.photo %>" alt="Complaint photo" style="max-width: 220px; max-height: 160px; border-radius: 8px; border: 1px solid var(--border-color); object-fit: cover;">
                      </a>
                    </div>
                  <% } %>
                </div>

                <!-- Resolution Area -->
                <% if (c.status === 'Raised') { %>
                  <!-- Inline Resolution Form -->
                  <div style="background: rgba(108, 99, 255, 0.05); border: 1px solid rgba(108, 99, 255, 0.2); border-radius: 8px; padding: 1.25rem; margin-top: 1rem;">
                    <h4 style="color: var(--primary); margin-bottom: 0.8rem; display: flex; align-items: center; gap: 0.5rem;">
                      <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg>
                      Resolve Complaint
                    </h4>

                    <form action="/admin/complaints/<%= c.id %>/resolve" method="POST" enctype="multipart/form-data">
                      <div class="form-group">
                        <label for="resolutionNote_<%= c.id %>">Resolution Description / Action Taken *</label>
                        <textarea id="resolutionNote_<%= c.id %>" name="resolutionNote" class="form-control" rows="3" placeholder="Describe how the issue was inspected/fixed..." required></textarea>
                      </div>

                      <div class="form-group">
                        <label for="resolutionPhoto_<%= c.id %>">Upload Resolution Photo Evidence (Optional — Max 5MB)</label>
                        <input type="file" id="resolutionPhoto_<%= c.id %>" name="resolutionPhoto" class="form-control" accept="image/jpeg,image/png,image/webp">
                      </div>

                      <button type="submit" class="btn btn-primary" style="width: auto; background-color: #22C55E; border: none; padding: 0.65rem 1.5rem;">
                        Mark as Resolved & Notify Resident
                      </button>
                    </form>
                  </div>
                <% } else { %>
                  <!-- Displayed Resolution Details -->
                  <div style="background: rgba(34, 197, 94, 0.08); border-radius: 8px; padding: 1.25rem; border: 1px dashed rgba(34, 197, 94, 0.3); margin-top: 1rem;">
                    <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 0.5rem;">
                      <p style="font-size: 0.85rem; color: #15803D; font-weight: 700;">Resolution Action Recorded:</p>
                      <span style="font-size: 0.8rem; color: var(--text-muted);">
                        Resolved on <%= c.resolvedAt ? new Date(c.resolvedAt).toLocaleString('en-IN') : 'N/A' %>
                      </span>
                    </div>
                    <p style="font-size: 0.95rem; color: #1F2937; margin-top: 0.3rem;"><%= c.resolutionNote %></p>
                    
                    <% if (c.resolutionPhoto) { %>
                      <div style="margin-top: 0.75rem;">
                        <p style="font-size: 0.8rem; color: #15803D; margin-bottom: 0.3rem; font-weight: 600;">Resolution Evidence Photo:</p>
                        <a href="<%= c.resolutionPhoto %>" target="_blank">
                          <img src="<%= c.resolutionPhoto %>" alt="Resolution photo" style="max-width: 220px; max-height: 160px; border-radius: 8px; border: 1px solid rgba(34, 197, 94, 0.3); object-fit: cover;">
                        </a>
                      </div>
                    <% } %>
                  </div>
                <% } %>

              </div>
            <% }); %>
          </div>
        <% } else { %>
          <p style="text-align: center; color: var(--text-muted); padding: 3rem 1rem;">No complaints raised by residents yet.</p>
        <% } %>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>
