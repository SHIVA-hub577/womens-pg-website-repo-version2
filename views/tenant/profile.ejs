<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Resident Profile & Rent Portal — Pujyasritha's Living</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="app-container" style="max-width: 900px;">
    <main class="main-content">
      <div style="margin-bottom: 1.5rem;">
        <h1>Resident Profile & Rent Portal</h1>
        <p style="color: var(--text-muted);">View room details, deposit information, and pay monthly rent.</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-info"><%= success %></div>
      <% } %>

      <% if (room && tenant) { %>
        <!-- Current Month Rent Payment Card -->
        <% 
          const rentAmount = tenant.rent || room.rent || 0;
          const isPaid = currentPayment && currentPayment.status === 'Paid';
          const isPartial = currentPayment && currentPayment.status === 'Partial';
          const partialPaid = currentPayment ? currentPayment.amountPaid : 0;
          const remainingDue = Math.max(0, rentAmount - partialPaid);
          const formattedMonth = typeof currentMonth !== 'undefined' ? currentMonth : new Date().toISOString().slice(0,7);
        %>
        <div class="card" style="margin-bottom: 1.5rem; background: linear-gradient(135deg, rgba(108, 99, 255, 0.05) 0%, rgba(255,255,255,1) 100%); border: 1px solid rgba(108, 99, 255, 0.2);">
          <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 1rem;">
            <div>
              <div style="font-size: 0.85rem; font-weight: 600; color: var(--primary); text-transform: uppercase; letter-spacing: 0.5px; margin-bottom: 0.25rem;">
                Rent Payment Status — <%= formattedMonth %>
              </div>
              <% if (isPaid) { %>
                <h3 style="color: #22C55E; margin: 0; display: flex; align-items: center; gap: 0.4rem;">
                  <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                  Rent Paid (₹<%= rentAmount.toLocaleString('en-IN') %>)
                </h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                  Paid on <%= currentPayment.paymentDate ? new Date(currentPayment.paymentDate).toLocaleDateString('en-IN') : 'Date recorded' %>
                </p>
              <% } else if (isPartial) { %>
                <h3 style="color: #CA8A04; margin: 0;">
                  Partially Paid (₹<%= partialPaid.toLocaleString('en-IN') %> paid)
                </h3>
                <p style="font-size: 0.85rem; color: #854D0E; margin-top: 0.25rem;">
                  Remaining Balance Due: <strong>₹<%= remainingDue.toLocaleString('en-IN') %></strong> out of ₹<%= rentAmount.toLocaleString('en-IN') %>
                </p>
              <% } else { %>
                <h3 style="color: #EF4444; margin: 0;">
                  Rent Payment Pending (₹<%= rentAmount.toLocaleString('en-IN') %>)
                </h3>
                <p style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.25rem;">
                  Rent due for <%= formattedMonth %>
                </p>
              <% } %>
            </div>

            <div>
              <% if (isPaid) { %>
                <span class="badge badge-green" style="font-size: 0.95rem; padding: 0.5rem 1rem;">
                  ✔ Paid for <%= formattedMonth %>
                </span>
              <% } else if (isPartial) { %>
                <form action="/tenant/pay" method="POST">
                  <button type="submit" class="btn" style="background-color: #EAB308; color: #FFFFFF; font-weight: 600;">
                    Pay Remaining Rent (₹<%= remainingDue.toLocaleString('en-IN') %>)
                  </button>
                </form>
              <% } else { %>
                <form action="/tenant/pay" method="POST">
                  <button type="submit" class="btn btn-primary" style="font-weight: 600;">
                    Pay Rent (₹<%= rentAmount.toLocaleString('en-IN') %>)
                  </button>
                </form>
              <% } %>
            </div>
          </div>
        </div>

        <div class="metric-grid">
          <div class="metric-card">
            <div class="metric-title">Assigned Room</div>
            <div class="metric-value">Room <%= room.roomNumber %></div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.3rem;"><%= room.sharingType %> Sharing Room</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Monthly Rent</div>
            <div class="metric-value" style="color: #22C55E;">₹<%= tenant.rent ? tenant.rent.toLocaleString('en-IN') : room.rent.toLocaleString('en-IN') %></div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.3rem;">Due monthly</div>
          </div>
          <div class="metric-card">
            <div class="metric-title">Advance Deposit Paid</div>
            <div class="metric-value" style="color: var(--primary);">₹<%= tenant.advancePaid ? tenant.advancePaid.toLocaleString('en-IN') : room.advance.toLocaleString('en-IN') %></div>
            <div style="font-size: 0.85rem; color: var(--text-muted); margin-top: 0.3rem;">Refundable deposit</div>
          </div>
        </div>

        <div class="card">
          <h2>Occupancy Summary</h2>
          <div style="margin-top: 1rem; display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 1rem;">
            <div>
              <p style="color: var(--text-muted); font-size: 0.85rem;">Tenant ID</p>
              <p style="font-weight: 600; font-size: 1rem;"><%= tenant.tenantId || 'N/A' %></p>
            </div>
            <div>
              <p style="color: var(--text-muted); font-size: 0.85rem;">Phone Number</p>
              <p style="font-weight: 600; font-size: 1rem;"><%= tenant.phone || 'N/A' %></p>
            </div>
            <div>
              <p style="color: var(--text-muted); font-size: 0.85rem;">Joining Date</p>
              <p style="font-weight: 600; font-size: 1rem;"><%= tenant.joiningDate ? new Date(tenant.joiningDate).toLocaleDateString('en-IN') : 'N/A' %></p>
            </div>
            <div>
              <p style="color: var(--text-muted); font-size: 0.85rem;">Status</p>
              <p><span class="badge badge-green"><%= tenant.status || 'Active Resident' %></span></p>
            </div>
          </div>
        </div>

      <% } else { %>
        <div class="card" style="text-align: center; padding: 3rem 1.5rem;">
          <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="#6C63FF" stroke-width="2" style="margin-bottom: 1rem;"><path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/><polyline points="9 22 9 12 15 12 15 22"/></svg>
          <h2 style="margin-bottom: 0.5rem;">No Room Assigned Yet</h2>
          <p style="color: var(--text-muted); max-width: 450px; margin: 0 auto 1.5rem auto;">
            Your tenant account (<strong>@<%= user ? user.username : '' %></strong>) is active, but you have not been assigned to a PG room yet. Please contact PG management for room allocation.
          </p>
          <span class="badge badge-purple" style="font-size: 0.9rem; padding: 0.4rem 1rem;">Status: Account Registered (Unassigned)</span>
        </div>
      <% } %>
    </main>
  </div>

  <%- include('../partials/footer') %>
</body>
</html>