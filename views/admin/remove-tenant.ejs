<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Remove Resident — Pujyasritha's Living</title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <%- include('../partials/header') %>

  <div class="app-container">
    <%- include('../partials/sidebar', { activePage: 'remove-tenant' }) %>

    <main class="main-content">
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 1.5rem; flex-wrap: wrap; gap: 1rem;">
        <div>
          <h1 style="color: var(--primary);">Remove Resident from Hostel</h1>
          <p style="color: var(--text-muted);">Select resident via cascading filters to send a 6-digit verification OTP code.</p>
        </div>
        <a href="/admin/tenants" class="btn btn-outline" style="width: auto;">&larr; Back to Directory</a>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="alert alert-danger"><%= error %></div>
      <% } %>

      <% if (typeof success !== 'undefined' && success) { %>
        <div class="alert alert-info"><%= success %></div>
      <% } %>

      <div class="card" style="max-width: 750px; margin-top: 1rem;">
        <form action="#" method="POST" id="removeTenantForm">
          
          <div style="background: rgba(239, 68, 68, 0.06); border: 1px solid rgba(239, 68, 68, 0.25); border-radius: var(--radius); padding: 1.5rem; margin-bottom: 1.5rem;">
            <h3 style="color: #DC2626; margin-bottom: 0.5rem; font-size: 1.1rem; display: flex; align-items: center; gap: 0.5rem;">
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
              Destructive Action: Resident Removal Selection
            </h3>
            <p style="font-size: 0.9rem; color: var(--text-muted); line-height: 1.5; margin-bottom: 1.25rem;">
              Initiating removal emails a 6-digit verification OTP to the resident. You must enter the OTP on the next screen to finalize removal.
            </p>

            <div style="display: flex; flex-direction: column; gap: 1.25rem;">
              
              <!-- 1. Sharing Type Dropdown -->
              <div class="form-group" style="margin-bottom: 0;">
                <label for="sharingFilter" style="font-weight: 600; display: block; margin-bottom: 0.4rem;">1. Select Room Sharing Type <span style="color: #DC2626;">*</span></label>
                <select id="sharingFilter" class="form-control">
                  <option value="">-- Select Sharing Type --</option>
                  <option value="all">All Sharing Types</option>
                  <option value="1">1 Sharing Room</option>
                  <option value="2">2 Sharing Room</option>
                  <option value="3">3 Sharing Room</option>
                  <option value="4">4 Sharing Room</option>
                </select>
              </div>

              <!-- 2. Room Number Dropdown (Cascading) -->
              <div class="form-group" style="margin-bottom: 0;">
                <label for="roomSelect" style="font-weight: 600; display: block; margin-bottom: 0.4rem;">2. Select Room Number <span style="color: #DC2626;">*</span></label>
                <select id="roomSelect" name="roomNumber" class="form-control" disabled required>
                  <option value="">-- Select Room Number --</option>
                  <% if (occupiedRooms && occupiedRooms.length > 0) { %>
                    <% occupiedRooms.forEach(r => { %>
                      <option 
                        value="<%= r.roomNumber %>" 
                        data-sharing="<%= r.sharingType %>"
                        data-tenants='<%= JSON.stringify(r.tenants || []) %>'
                      >
                        Room <%= r.roomNumber %> — <%= r.sharingType %> Sharing (<%= r.tenants ? r.tenants.length : 0 %> occupants)
                      </option>
                    <% }); %>
                  <% } %>
                </select>
              </div>

              <!-- 3. Tenant Dropdown (Cascading) -->
              <div class="form-group" style="margin-bottom: 0;">
                <label for="tenantSelect" style="font-weight: 600; display: block; margin-bottom: 0.4rem;">3. Select Resident to Remove <span style="color: #DC2626;">*</span></label>
                <select id="tenantSelect" class="form-control" disabled required>
                  <option value="">-- Select Resident --</option>
                </select>
              </div>

            </div>
          </div>

          <div style="margin-top: 1.5rem;">
            <button type="submit" id="submitBtn" class="btn" style="background-color: #DC2626; color: #FFFFFF; width: 100%; padding: 0.85rem; font-weight: 600; opacity: 0.5; cursor: not-allowed;" disabled>
              Send Removal OTP to Resident
            </button>
          </div>
        </form>
      </div>
    </main>
  </div>

  <%- include('../partials/footer') %>

  <!-- Cascading Dropdowns & Confirmation Prompt JS -->
  <script>
    const sharingFilter = document.getElementById('sharingFilter');
    const roomSelect = document.getElementById('roomSelect');
    const tenantSelect = document.getElementById('tenantSelect');
    const submitBtn = document.getElementById('submitBtn');
    const removeForm = document.getElementById('removeTenantForm');

    sharingFilter.addEventListener('change', function() {
      const val = this.value;
      roomSelect.selectedIndex = 0;
      tenantSelect.innerHTML = '<option value="">-- Select Resident --</option>';
      tenantSelect.disabled = true;
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.5';
      submitBtn.style.cursor = 'not-allowed';

      if (!val) {
        roomSelect.disabled = true;
        return;
      }

      roomSelect.disabled = false;
      const options = roomSelect.options;
      for (let i = 1; i < options.length; i++) {
        const opt = options[i];
        const sharing = opt.dataset.sharing;
        if (val === 'all' || sharing === val) {
          opt.style.display = '';
        } else {
          opt.style.display = 'none';
        }
      }
    });

    roomSelect.addEventListener('change', function() {
      tenantSelect.innerHTML = '<option value="">-- Select Resident --</option>';
      submitBtn.disabled = true;
      submitBtn.style.opacity = '0.5';
      submitBtn.style.cursor = 'not-allowed';

      const selectedOpt = this.options[this.selectedIndex];
      if (!selectedOpt || !selectedOpt.value) {
        tenantSelect.disabled = true;
        return;
      }

      const tenantsData = JSON.parse(selectedOpt.dataset.tenants || '[]');
      if (tenantsData.length === 0) {
        tenantSelect.disabled = true;
        return;
      }

      tenantSelect.disabled = false;
      tenantsData.forEach(t => {
        const opt = document.createElement('option');
        opt.value = t.tenantId;
        opt.dataset.name = t.name;
        opt.dataset.email = t.email;
        opt.textContent = `${t.name} (ID: ${t.tenantId} • ${t.email || 'No email'})`;
        tenantSelect.appendChild(opt);
      });
    });

    tenantSelect.addEventListener('change', function() {
      const selectedOpt = this.options[this.selectedIndex];
      if (selectedOpt && selectedOpt.value) {
        submitBtn.disabled = false;
        submitBtn.style.opacity = '1';
        submitBtn.style.cursor = 'pointer';
        removeForm.action = `/admin/tenants/${selectedOpt.value}/request-removal`;
      } else {
        submitBtn.disabled = true;
        submitBtn.style.opacity = '0.5';
        submitBtn.style.cursor = 'not-allowed';
      }
    });

    removeForm.addEventListener('submit', function(e) {
      const selectedOpt = tenantSelect.options[tenantSelect.selectedIndex];
      const email = selectedOpt.dataset.email || 'the resident';
      const name = selectedOpt.dataset.name || 'Resident';

      const confirmed = confirm(`This will send a removal OTP to ${email} for ${name}. Continue?`);
      if (!confirmed) {
        e.preventDefault();
      }
    });
  </script>
</body>
</html>
